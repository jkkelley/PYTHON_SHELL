{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListOnlyWithinPrefix",
            "Effect": "Allow",
            "Action": ["s3:ListBucket"],
            "Resource": "arn:aws:s3:::python-lib-690712292635-us-east-2-an",
            "Condition": {
                "StringLike": {
                    "s3:prefix": ["macos-userdata-test/*"]
                }
            }
        },
        {
            "Sid": "ObjectReadWriteWithinPrefix",
            "Effect": "Allow",
            "Action": ["s3:GetObject", "s3:PutObject"],
            "Resource": "arn:aws:s3:::python-lib-690712292635-us-east-2-an/macos-userdata-test/*"
        },
        {
            "Sid": "SelfTerminateOnly",
            "Effect": "Allow",
            "Action": ["ec2:TerminateInstances"],
            "Resource": "arn:aws:ec2:us-east-2:690712292635:instance/*",
            "Condition": {
                "StringEquals": {
                    "ec2:ResourceTag/Project": "macos-userdata-test"
                }
            }
        }
    ]
}
